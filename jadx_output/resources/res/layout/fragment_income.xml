<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_secondary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.boilerplate.uikit.views.textviews.text20.TextViewBold20
        android:id="@+id/tv_expense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_12"
        android:text="@string/income"
        android:layout_marginStart="@dimen/margin_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.boilerplate.uikit.views.textviews.text12.TextViewBold12
        android:textSize="@dimen/text_12"
        android:gravity="center"
        android:id="@+id/tv_month_year"
        android:background="@drawable/transparent_border_button_4"
        android:paddingLeft="@dimen/margin_6"
        android:paddingTop="@dimen/margin_2"
        android:paddingRight="@dimen/margin_6"
        android:paddingBottom="@dimen/margin_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_12"
        android:drawablePadding="@dimen/margin_4"
        android:drawableStart="@drawable/ic_calendar"
        android:drawableEnd="@drawable/ic_chevron_down"
        android:layout_marginEnd="@dimen/margin_8"
        android:paddingHorizontal="@dimen/margin_6"
        android:paddingVertical="@dimen/margin_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="@dimen/margin_12"/>
    <com.boilerplate.uikit.views.textviews.text16.TextViewBold16
        android:id="@+id/tv_add_first_entry"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_8"
        android:text="@string/add_your_first_entry"
        app:layout_constraintBottom_toTopOf="@+id/iv_arrow"
        app:layout_constraintEnd_toEndOf="@+id/btn_cash_in"
        app:layout_constraintStart_toStartOf="@+id/btn_cash_in"/>
    <ImageView
        android:id="@+id/iv_arrow"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_8"
        android:src="@drawable/ic_arrow_down"
        app:layout_constraintBottom_toTopOf="@+id/btn_cash_in"
        app:layout_constraintEnd_toEndOf="@+id/btn_cash_in"
        app:layout_constraintStart_toStartOf="@+id/btn_cash_in"/>
    <EditText
        android:textSize="@dimen/text_14"
        android:textColorHint="@color/hint_text_color"
        android:gravity="center_vertical"
        android:id="@+id/et_search_income"
        android:background="@drawable/rounded_border_edittext_background_100"
        android:padding="@dimen/margin_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_12"
        android:layout_marginTop="@dimen/margin_16"
        android:layout_marginRight="@dimen/margin_12"
        android:layout_marginBottom="@dimen/margin_16"
        android:hint="@string/search_by_income_name"
        android:drawablePadding="@dimen/margin_8"
        android:inputType="textPersonName"
        android:drawableStart="@drawable/ic_search"
        android:layout_marginHorizontal="@dimen/margin_12"
        android:layout_marginVertical="@dimen/margin_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_expense"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btn_cash_in"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_search_income">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_stats"
                android:background="@drawable/bg_rounded_white_12"
                android:paddingLeft="@dimen/margin_8"
                android:paddingTop="@dimen/margin_8"
                android:paddingRight="@dimen/margin_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_12"
                android:baselineAligned="false"
                android:paddingHorizontal="@dimen/margin_8">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_stats_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.boilerplate.uikit.views.textviews.text10.TextViewHintBold10
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_entries_title"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/total_entries"
                            android:textAllCaps="true"/>
                        <com.boilerplate.uikit.views.textviews.text16.TextViewBold16
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_total_entries"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_4"
                            android:text="@string/_0"/>
                    </LinearLayout>
                    <View
                        android:background="@color/divider_color"
                        android:layout_width="@dimen/margin_1"
                        android:layout_height="match_parent"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_parent_total_cash_in"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.boilerplate.uikit.views.textviews.text10.TextViewHintBold10
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_cash_in_title"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/total_in"
                            android:textAllCaps="true"/>
                        <LinearLayout
                            android:layout_gravity="center"
                            android:orientation="horizontal"
                            android:id="@+id/ll_total_cash_in"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_4">
                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:id="@+id/ic_hidden_amount"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/ic_secret_amount"/>
                                <com.boilerplate.uikit.views.textviews.text16.TextViewBoldGreen16
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@+id/tv_total_cash_in"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/_rupee_0"/>
                            </FrameLayout>
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/iv_eye_open_close"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/margin_8"
                                android:layout_marginRight="@dimen/margin_8"
                                android:src="@drawable/ic_eye_open"
                                android:layout_marginHorizontal="@dimen/margin_8"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_1"
                    android:layout_marginTop="@dimen/margin_8"/>
                <com.boilerplate.uikit.views.textviews.text14.TextViewBoldPrimaryColor14
                    android:gravity="center"
                    android:id="@+id/tv_view_reports"
                    android:paddingTop="@dimen/margin_8"
                    android:paddingBottom="@dimen/margin_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/view_reports"
                    android:paddingVertical="@dimen/margin_8"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_table_header"
                android:background="@color/white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_4"
                android:layout_marginTop="@dimen/margin_12"
                android:layout_marginRight="@dimen/margin_4"
                android:layout_marginHorizontal="@dimen/margin_4">
                <com.boilerplate.uikit.views.textviews.text14.TextViewBold14
                    android:gravity="center"
                    android:paddingTop="@dimen/margin_8"
                    android:paddingBottom="@dimen/margin_8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/date"
                    android:layout_weight="0.6"
                    android:paddingVertical="@dimen/margin_8"/>
                <View
                    android:background="@color/divider_color"
                    android:layout_width="@dimen/margin_1"
                    android:layout_height="match_parent"/>
                <com.boilerplate.uikit.views.textviews.text14.TextViewBold14
                    android:gravity="start|center_vertical"
                    android:paddingLeft="@dimen/margin_8"
                    android:paddingTop="@dimen/margin_8"
                    android:paddingRight="@dimen/margin_8"
                    android:paddingBottom="@dimen/margin_8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/notes"
                    android:layout_weight="1.5"
                    android:paddingHorizontal="@dimen/margin_8"
                    android:paddingVertical="@dimen/margin_8"/>
                <View
                    android:background="@color/divider_color"
                    android:layout_width="@dimen/margin_1"
                    android:layout_height="match_parent"/>
                <com.boilerplate.uikit.views.textviews.text14.TextViewBold14
                    android:gravity="start|center_vertical"
                    android:paddingTop="@dimen/margin_8"
                    android:paddingBottom="@dimen/margin_8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/rupee_amount"
                    android:layout_weight="1.2"
                    android:paddingStart="@dimen/margin_8"
                    android:paddingVertical="@dimen/margin_8"/>
            </LinearLayout>
            <View
                android:id="@+id/divider_header"
                android:background="@color/divider_color"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_1"
                android:layout_marginLeft="@dimen/margin_12"
                android:layout_marginRight="@dimen/margin_12"
                android:layout_marginHorizontal="@dimen/margin_12"/>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="center"
                android:id="@+id/rv_expense"
                android:paddingBottom="@dimen/margin_40"
                android:visibility="gone"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_4"
                android:layout_marginTop="0dp"
                android:layout_marginRight="@dimen/margin_4"
                android:nestedScrollingEnabled="false"
                android:layout_marginHorizontal="@dimen/margin_4"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.boilerplate.uikit.views.buttons.RoundedGreenButton
        android:orientation="horizontal"
        android:id="@+id/btn_cash_in"
        android:layout_width="@dimen/margin_150"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_16"
        android:text="@string/cash_in"
        android:textAllCaps="true"
        android:layout_marginStart="@dimen/margin_6"
        app:icon="@drawable/ic_cash_in"
        app:iconPadding="@dimen/margin_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nested_scroll_view"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
