<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_close"
        android:background="@drawable/circle_bg_white"
        android:padding="@dimen/margin_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_12"
        android:layout_marginTop="@dimen/margin_8"
        android:layout_marginRight="@dimen/margin_12"
        android:layout_marginBottom="@dimen/margin_8"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/close"
        android:layout_marginHorizontal="@dimen/margin_12"
        android:layout_marginVertical="@dimen/margin_8"
        app:layout_constraintBottom_toTopOf="@+id/cl_attendance"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_attendance"
        android:background="@drawable/rounded_top_edittext_background_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.boilerplate.uikit.views.textviews.text20.TextViewRegular20
            android:ellipsize="end"
            android:id="@+id/tv_advance_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_16"
            android:layout_marginTop="@dimen/margin_16"
            android:layout_marginRight="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_2"
            android:text="@string/advance_amount"
            android:layout_marginHorizontal="@dimen/margin_16"
            app:layout_constraintBottom_toTopOf="@+id/tv_staff_name"
            app:layout_constraintEnd_toStartOf="@+id/tv_date"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.boilerplate.uikit.views.textviews.text14.TextViewBold14
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_16"
            android:layout_marginTop="@dimen/margin_16"
            android:layout_marginRight="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_2"
            android:layout_marginHorizontal="@dimen/margin_16"
            app:layout_constraintBottom_toTopOf="@+id/tv_staff_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.boilerplate.uikit.views.textviews.text16.TextViewBold16
            android:id="@+id/tv_staff_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_16"
            android:layout_marginRight="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_20"
            android:layout_marginHorizontal="@dimen/margin_16"
            app:layout_constraintBottom_toTopOf="@+id/rl_amount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rl_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_16"
            android:layout_marginRight="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_20"
            android:layout_marginHorizontal="@dimen/margin_16"
            app:layout_constraintBottom_toTopOf="@+id/divider_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.boilerplate.uikit.views.textviews.text48.TextViewBoldPrimaryColor48
                android:id="@+id/rupee_symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rupee"
                android:paddingEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.google.android.material.textfield.TextInputEditText
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColorHint="@color/hint_text_color"
                android:gravity="start"
                android:id="@+id/et_advance"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/_0"
                android:maxLength="10"
                android:inputType="number"
                android:layout_marginStart="@dimen/margin_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/rupee_symbol"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_payment_method"
                android:background="@drawable/toggle_button_container"
                android:padding="@dimen/margin_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_primary"
                    android:gravity="center"
                    android:id="@+id/rb_online"
                    android:tag="online"
                    android:background="@drawable/toggle_button_left"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingTop="@dimen/margin_4"
                    android:paddingRight="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_4"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="45dp"
                    android:minHeight="28dp"
                    android:text="@string/online"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:paddingHorizontal="@dimen/margin_10"
                    android:paddingVertical="@dimen/margin_4"/>
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/rb_cash"
                    android:tag="cash"
                    android:background="@drawable/toggle_button_right_selected"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingTop="@dimen/margin_4"
                    android:paddingRight="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_4"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="45dp"
                    android:minHeight="28dp"
                    android:text="@string/cash"
                    android:layout_marginStart="@dimen/margin_2"
                    android:paddingHorizontal="@dimen/margin_10"
                    android:paddingVertical="@dimen/margin_4"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/divider_1"
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_1"
            android:layout_marginBottom="@dimen/margin_16"
            app:layout_constraintBottom_toTopOf="@+id/tv_title_advance"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.boilerplate.uikit.views.textviews.text16.TextViewRegular16
            android:ellipsize="end"
            android:id="@+id/tv_title_advance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_16"
            android:layout_marginTop="@dimen/margin_16"
            android:layout_marginRight="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_8"
            android:text="@string/notes"
            android:layout_marginHorizontal="@dimen/margin_16"
            app:layout_constraintBottom_toTopOf="@+id/et_description"
            app:layout_constraintEnd_toStartOf="@+id/tv_date"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"/>
        <EditText
            android:textSize="@dimen/text_14"
            android:textColorHint="@color/hint_text_color"
            android:id="@+id/et_description"
            android:background="@drawable/rounded_border_edittext_background_100"
            android:padding="@dimen/margin_10"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_40"
            android:layout_marginLeft="@dimen/margin_16"
            android:layout_marginRight="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_16"
            android:hint="@string/eg_food_petrol_rent"
            android:inputType="textShortMessage"
            android:layout_marginHorizontal="@dimen/margin_16"
            app:layout_constraintBottom_toTopOf="@+id/divider_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/divider_2"
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_1"
            android:layout_marginBottom="@dimen/margin_8"
            app:layout_constraintBottom_toTopOf="@+id/btn_add_advance"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textColor="@color/color_primary"
            android:gravity="center"
            android:id="@+id/btn_remove_advance"
            android:background="@drawable/rounded_border_button_color_primary_100"
            android:paddingTop="@dimen/margin_13"
            android:paddingBottom="@dimen/margin_13"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_16"
            android:text="@string/delete_advace"
            android:layout_marginStart="@dimen/margin_16"
            android:paddingVertical="@dimen/margin_13"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_add_advance"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.boilerplate.uikit.views.buttons.PrimaryButton
            android:id="@+id/btn_add_advance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_16"
            android:layout_marginTop="@dimen/margin_16"
            android:layout_marginRight="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_16"
            android:text="@string/ok"
            android:layout_marginHorizontal="@dimen/margin_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/btn_remove_advance"/>
        <ProgressBar
            android:id="@+id/pb"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
