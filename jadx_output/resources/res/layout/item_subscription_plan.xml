<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_plan_root"
    android:background="@drawable/plan_unselected_border"
    android:paddingLeft="@dimen/margin_16"
    android:paddingTop="@dimen/margin_14"
    android:paddingRight="@dimen/margin_16"
    android:paddingBottom="@dimen/margin_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_8"
    android:paddingHorizontal="@dimen/margin_16"
    android:paddingVertical="@dimen/margin_14">
    <ImageView
        android:id="@+id/iv_selection_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_radio_unselected"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/tv_plan_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_12"
        app:layout_constraintStart_toEndOf="@+id/iv_selection_check"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/hint_text_color"
        android:id="@+id/tv_plan_breakdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="@dimen/margin_12"
        app:layout_constraintStart_toEndOf="@+id/iv_selection_check"
        app:layout_constraintTop_toBottomOf="@+id/tv_plan_name"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/tv_per_month_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:id="@+id/tv_discount_badge"
        android:background="@drawable/bg_discount_badge"
        android:paddingLeft="@dimen/margin_8"
        android:paddingTop="2dp"
        android:paddingRight="@dimen/margin_8"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_8"
        android:paddingHorizontal="@dimen/margin_8"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_plan_name"
        app:layout_constraintStart_toEndOf="@+id/tv_plan_name"
        app:layout_constraintTop_toTopOf="@+id/tv_plan_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
