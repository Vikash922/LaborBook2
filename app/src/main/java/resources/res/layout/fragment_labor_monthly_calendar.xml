<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_secondary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:background="@color/background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_back"
            android:paddingLeft="@dimen/margin_8"
            android:paddingTop="@dimen/margin_12"
            android:paddingRight="@dimen/margin_8"
            android:paddingBottom="@dimen/margin_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_back_small"
            android:contentDescription="@string/back"
            android:paddingHorizontal="@dimen/margin_8"
            android:paddingVertical="@dimen/margin_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.boilerplate.uikit.views.textviews.text18.TextViewBold18
            android:id="@+id/tv_toolbar_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_12"
            app:layout_constraintBottom_toBottomOf="@+id/iv_back"
            app:layout_constraintEnd_toStartOf="@+id/tv_edit"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/iv_back"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.boilerplate.uikit.views.textviews.text12.TextViewBold12
            android:textSize="@dimen/text_12"
            android:gravity="center"
            android:id="@+id/tv_edit"
            android:background="@drawable/transparent_border_button_4"
            android:paddingLeft="@dimen/margin_6"
            android:paddingTop="@dimen/margin_2"
            android:paddingRight="@dimen/margin_6"
            android:paddingBottom="@dimen/margin_2"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit"
            android:drawablePadding="@dimen/margin_4"
            android:drawableStart="@drawable/ic_edit"
            android:layout_marginEnd="@dimen/margin_6"
            android:paddingHorizontal="@dimen/margin_6"
            android:paddingVertical="@dimen/margin_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_delete_staff"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_delete_staff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_delete"
            android:layout_marginEnd="@dimen/margin_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/divider_4"
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_date_selector"
        android:padding="@dimen/margin_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_4">
        <com.boilerplate.uikit.views.textviews.text12.TextViewHintRegular12
            android:textSize="@dimen/text_12"
            android:textColor="@color/text_16_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/overview"
            android:layout_weight="1"/>
        <com.boilerplate.uikit.views.textviews.text12.TextViewBold12
            android:textSize="@dimen/text_12"
            android:gravity="center"
            android:id="@+id/tv_month_year"
            android:background="@drawable/transparent_border_button_4"
            android:paddingLeft="@dimen/margin_6"
            android:paddingTop="@dimen/margin_4"
            android:paddingRight="@dimen/margin_6"
            android:paddingBottom="@dimen/margin_4"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/margin_4"
            android:drawableStart="@drawable/ic_calendar"
            android:drawableEnd="@drawable/ic_chevron_down"
            android:paddingHorizontal="@dimen/margin_6"
            android:paddingVertical="@dimen/margin_4"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/divider_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_date_selector">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="start|center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_stats"
                android:background="@color/background"
                android:padding="@dimen/margin_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_4">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_stats_first_row"
                    android:padding="@dimen/margin_4"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_8">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.boilerplate.uikit.views.textviews.text16.TextViewBoldGreen16
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_total_present"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <com.boilerplate.uikit.views.textviews.text10.TextViewRegular10
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_present"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.boilerplate.uikit.views.textviews.text16.TextViewBoldError16
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_total_absent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <com.boilerplate.uikit.views.textviews.text10.TextViewRegular10
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_absent"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.boilerplate.uikit.views.textviews.text16.TextViewBold16
                            android:textColor="@color/text_16_color"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_total_ot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <com.boilerplate.uikit.views.textviews.text10.TextViewRegular10
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/over_time"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.boilerplate.uikit.views.textviews.text16.TextViewBold16
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_total_advance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <com.boilerplate.uikit.views.textviews.text10.TextViewRegular10
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_advance"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/iv_stats_dropdown"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/margin_4"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_chevron_down"
                        android:layout_marginStart="@dimen/margin_4"
                        app:tint="@color/color_primary"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_stats_second_row"
                    android:padding="@dimen/margin_8"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.boilerplate.uikit.views.textviews.text16.TextViewBold16
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_total_half_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <com.boilerplate.uikit.views.textviews.text10.TextViewRegular10
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/half_day"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.boilerplate.uikit.views.textviews.text16.TextViewBold16
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_total_pp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <com.boilerplate.uikit.views.textviews.text10.TextViewRegular10
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_pp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.boilerplate.uikit.views.textviews.text16.TextViewBold16
                            android:textColor="@color/text_16_color"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_total_ph"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <com.boilerplate.uikit.views.textviews.text10.TextViewRegular10
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_ph"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <com.boilerplate.uikit.views.textviews.text14.TextViewBoldPrimaryColor14
                                android:textColor="@color/color_primary"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@+id/tv_add_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <ImageView
                                android:id="@+id/iv_refresh_amount"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_refresh"
                                android:contentDescription="@string/refresh"
                                android:layout_marginStart="8dp"/>
                        </LinearLayout>
                        <com.boilerplate.uikit.views.textviews.text10.TextViewRegular10
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/amount_to_pay"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_open_report"
                android:background="#f2f7ff"
                android:paddingTop="@dimen/margin_8"
                android:paddingBottom="@dimen/margin_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_report_icon"
                    android:layout_width="@dimen/margin_20"
                    android:layout_height="@dimen/margin_20"
                    android:src="@drawable/ic_report"
                    android:contentDescription="@string/open_report"
                    android:layout_marginEnd="@dimen/margin_8"/>
                <com.boilerplate.uikit.views.textviews.text14.TextViewBoldPrimaryColor14
                    android:textColor="@color/color_primary"
                    android:gravity="center"
                    android:id="@+id/btn_open_report"
                    android:background="@android:color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/open_report"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_table_header"
                android:background="@color/background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_4">
                <com.boilerplate.uikit.views.textviews.text14.TextViewBold14
                    android:gravity="center"
                    android:paddingLeft="@dimen/margin_12"
                    android:paddingTop="@dimen/margin_4"
                    android:paddingRight="@dimen/margin_12"
                    android:paddingBottom="@dimen/margin_4"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="@string/date"
                    android:paddingHorizontal="@dimen/margin_12"
                    android:paddingVertical="@dimen/margin_4"/>
                <View
                    android:id="@+id/divider_1"
                    android:background="@color/divider_color"
                    android:layout_width="@dimen/margin_1"
                    android:layout_height="match_parent"/>
                <com.boilerplate.uikit.views.textviews.text14.TextViewBold14
                    android:ellipsize="end"
                    android:paddingTop="@dimen/margin_8"
                    android:paddingBottom="@dimen/margin_8"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="@string/attendance"
                    android:maxLines="1"
                    android:paddingStart="@dimen/margin_12"
                    android:paddingVertical="@dimen/margin_8"/>
                <ImageView
                    android:id="@+id/iv_more"
                    android:padding="@dimen/margin_4"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/margin_4"
                    android:layout_marginRight="@dimen/margin_4"
                    android:src="@drawable/ic_more"
                    android:layout_marginHorizontal="@dimen/margin_4"/>
                <View
                    android:id="@+id/divider_2"
                    android:background="@color/divider_color"
                    android:layout_width="@dimen/margin_1"
                    android:layout_height="match_parent"/>
                <com.boilerplate.uikit.views.textviews.text14.TextViewBold14
                    android:ellipsize="end"
                    android:paddingLeft="@dimen/margin_12"
                    android:paddingTop="@dimen/margin_8"
                    android:paddingRight="@dimen/margin_12"
                    android:paddingBottom="@dimen/margin_8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/advance"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:paddingHorizontal="@dimen/margin_12"
                    android:paddingVertical="@dimen/margin_8"/>
            </LinearLayout>
            <View
                android:id="@+id/divider_3"
                android:background="@color/divider_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_1"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_attendance"
                android:background="@color/background"
                android:paddingBottom="@dimen/margin_64"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_4"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:id="@+id/divider_button"
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_1"
        app:layout_constraintBottom_toTopOf="@+id/fl_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nested_scroll_view"/>
    <FrameLayout
        android:id="@+id/fl_button"
        android:background="@color/background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.boilerplate.uikit.views.buttons.PrimaryButton
            android:id="@+id/btn_mark_attendance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_16"
            android:layout_marginTop="@dimen/margin_8"
            android:layout_marginRight="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_8"
            android:text="@string/ok"
            android:layout_marginHorizontal="@dimen/margin_16"
            android:layout_marginVertical="@dimen/margin_8"/>
    </FrameLayout>
    <ProgressBar
        android:id="@+id/pb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/btn_share"
        android:background="@drawable/rounded_button_black_100"
        android:paddingLeft="@dimen/margin_12"
        android:paddingTop="@dimen/margin_8"
        android:paddingRight="@dimen/margin_12"
        android:paddingBottom="@dimen/margin_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_16"
        android:layout_marginTop="@dimen/margin_48"
        android:layout_marginRight="@dimen/margin_16"
        android:layout_marginBottom="@dimen/margin_48"
        android:text="@string/share_to"
        android:drawablePadding="@dimen/margin_4"
        android:fontFamily="@font/inter_bold"
        android:layout_marginHorizontal="@dimen/margin_16"
        android:layout_marginVertical="@dimen/margin_48"
        android:paddingHorizontal="@dimen/margin_12"
        android:paddingVertical="@dimen/margin_8"
        app:drawableStartCompat="0x7f080167"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
